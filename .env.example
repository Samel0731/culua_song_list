# Public site / basic Google OAuth via Supabase
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never use NEXT_PUBLIC_ for these values.
SUPABASE_SERVICE_ROLE_KEY=
ARCHIVE_BACKUP_KEY=
ARCHIVE_REVALIDATE_SECRET=
# Keep sheet until the initial import and counts/link comparison pass.
ARCHIVE_DATA_SOURCE=sheet
# Worker (GitHub Actions secrets / variables, not browser)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Optional immediate worker-to-site cache refresh
ARCHIVE_SITE_URL=
# Optional curation: configure only after publishing each Sheet tab as CSV.
FANART_SHEET_CSV_URL=
FEATURED_WORKS_SHEET_CSV_URL=
